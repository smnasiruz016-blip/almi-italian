# AlmiItalian env template. Copy to .env (git-ignored). Never commit real secrets.

# Neon Postgres. Runtime uses the POOLED host and MUST carry pgbouncer=true (network gotcha).
DATABASE_URL="postgresql://USER:PASSWORD@POOLED-HOST/DB?sslmode=require&pgbouncer=true"
# Direct (unpooled) host for prisma migrations.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@DIRECT-HOST/DB?sslmode=require"

APP_URL="https://almiitalian.almiworld.com"

# Access tiers (comma-separated emails). OWNER = unlimited/premium bypass; ADMIN = /admin panel.
OWNER_EMAILS="almiworld@almiworld.com"
ADMIN_EMAILS="almiworld@almiworld.com"

# Billing (Stripe). Billing stays OFF (fail-closed) until BOTH the secret key and price id are set.
# Founder creates the "AlmiItalian Pro" product ($12/mo, 7-day trial) in the shared AlmiWorld Stripe account.
STRIPE_SECRET_KEY=""
STRIPE_PRICE_ID=""
STRIPE_WEBHOOK_SECRET=""

# ── Transactional email (Resend). Verify the domain in PRODUCTION, not the sandbox. ──
# EMAIL_FROM is the single network-wide sender; every AlmiWorld product sends as this address.
RESEND_API_KEY=""
EMAIL_FROM="almiworld@almiworld.com"

# Public base URL, read in the BROWSER (canonical links, share URLs). Must be the
# production origin — NEXT_PUBLIC_* is inlined at build time, so a wrong value here
# ships to every visitor and cannot be corrected without a rebuild.
NEXT_PUBLIC_APP_URL="https://almiitalian.almiworld.com"

# ── Admin/ops surface ──
# ONE value shared across the whole AlmiWorld network (source of truth:
# almi-billing-router/.env). Never regenerate it per-product — doing so silently
# breaks every other product that authenticates against the same secret.
ADMIN_API_SECRET=""

# Shared secret for the consolidated billing router's webhook fan-out. Set by the
# founder; the app verifies it before acting on a forwarded Stripe event.
ROUTER_WEBHOOK_SECRET=""

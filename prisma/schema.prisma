// AlmiItalian — Prisma schema (CILS + CELI). Forked from the AlmiWorld network pattern.
// TWO exam families, THREE engine paths, each on its own scale — never mixed (see src/lib/scoring/*):
//   CILS_STANDARD (5 sections /20, floor 11, capitalization) · CILS_B1C (4 sections /12, floor 7 +
//   total 28/48, no banking) · CELI (Written + Oral parts, both must clear, A–E band estimate).
// Item bank dedup key = {exam, level, section, title} (specs §5). Section/level are strings because
// their vocabulary differs per engine; the engine code — not the DB — owns the scoring rules.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") //          pooled (pgbouncer=true) for runtime
  directUrl = env("DATABASE_URL_UNPOOLED") // direct for migrations
}

// The three engine paths (never blended).
enum ItalianExam {
  CILS_STANDARD
  CILS_B1C
  CELI
}

enum ItalianTaskType {
  MCQ
  MATCHING
  ORDERING
  CLOZE
  ANALISI //   CILS grammar/structures — a first-class item type
  WRITING
  SPEAKING
}

enum Difficulty {
  FOUNDATION
  CORE
  STRETCH
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  SCORED
}

enum SessionMode {
  PRACTICE_SET
  MOCK
}

model User {
  id                           String       @id @default(cuid())
  email                        String       @unique
  passwordHash                 String
  name                         String?
  locale                       String       @default("en")
  targetExam                   ItalianExam?
  emailVerifiedAt              DateTime?
  emailVerificationTokenHash   String?      @unique
  emailVerificationExpiresAt   DateTime?
  emailVerificationLastSentAt  DateTime?
  stripeCustomerId             String?
  stripeSubscriptionId         String?
  subscriptionStatus           String? //  Stripe status: trialing | active | canceled | ...
  subscriptionCurrentPeriodEnd DateTime?
  compProUntil                 DateTime? // admin-granted comp Pro window (bypasses billing)
  compGrantedAt                DateTime? // when the comp was granted
  compGrantedBy                String? // admin email that granted it
  compReason                   String? // free-text note (e.g. "Beta tester batch 1")
  // The 3-day no-card window on the OBJECTIVE sections. NULL = never started; the clock is
  // set by the first graded submission, never by signup, and never restarted (see
  // src/lib/free-window.ts). Network standard, ported from AlmiCELPIP.
  freeAccessStartedAt          DateTime?
  createdAt                    DateTime     @default(now())
  updatedAt                    DateTime     @updatedAt

  attempts      ItalianAttempt[]
  sessions      ItalianSession[]
  aiCosts       AICostLedger[]
  aiEvaluations AiEvaluation[]
  authSessions  AuthSession[]
  reviews       Review[]
}

// Server-side auth sessions (canonical AlmiWorld pattern: hashed token in a cookie).
model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// The item bank. level + section are strings (their vocabulary differs by engine).
//  CILS_STANDARD sections: ASCOLTO/LETTURA/ANALISI/SCRITTA/ORALE (level A1..QUATTRO)
//  CILS_B1C      sections: ASCOLTO/LETTURA/SCRITTA/ORALE (level B1c)
//  CELI          sections: WRITTEN/ORAL (level IMPATTO..CINQUE)
model ItalianItem {
  id           String          @id @default(cuid())
  exam         ItalianExam
  level        String
  section      String
  taskType     ItalianTaskType
  difficulty   Difficulty      @default(CORE)
  title        String
  prompt       String?
  topicTag     String?
  guidanceNote String?
  payload      Json
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  attempts ItalianAttempt[]

  @@unique([exam, level, section, title])
  @@index([exam, level, section])
}

model ItalianAttempt {
  id        String        @id @default(cuid())
  userId    String
  itemId    String
  exam      ItalianExam
  level     String
  section   String
  status    AttemptStatus @default(IN_PROGRESS)
  sessionId String?
  response  Json?
  result    Json? // scored read-out per the relevant engine (never an official result)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  item    ItalianItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  session ItalianSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId, exam])
}

model ItalianSession {
  id                String      @id @default(cuid())
  userId            String
  mode              SessionMode
  exam              ItalianExam
  level             String
  section           String? //  set for PRACTICE_SET, null for MOCK (all sections)
  currentDifficulty Difficulty  @default(CORE)
  result            Json? // aggregate practice result for a MOCK, per the relevant engine
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts ItalianAttempt[]

  @@index([userId, mode])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  text      String   @db.Text
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([approved, createdAt])
}

// ── AI FEEDBACK (Produzione scritta / orale) ────────────────────────────────
// The estimate skills. Everything here is an ESTIMATE, never an official result — see
// AiEvaluation.labelKind, which the renderer requires and scripts/gates/honesty-gate.mts
// enforces at build time.

enum AiSkill {
  SCRITTA
  ORALE
}

/// Every metered model call, including the failures at cost 0. Written by recordCost() in
/// src/lib/ai/anthropic-client.ts. Costs are integer 1/100-cents (1 = $0.0001) so tiny
/// amounts store exactly without Decimal overhead — AlmiPTE's unit, kept identical so the
/// network's ledgers stay comparable.
model AICostLedger {
  id               String   @id @default(cuid())
  userId           String?
  feature          String //  e.g. "scritta.evaluate", "orale.transcribe"
  model            String
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  costCents        Int      @default(0) // 1/100 cents
  success          Boolean  @default(true)
  errorMessage     String?
  createdAt        DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([feature, createdAt])
}

/// One AI-estimated attempt at a Produzione scritta or orale task.
///
/// Keyed by the bank's STABLE ITEM ID (sha256 of {exam, level, section, title}), not by a
/// foreign key: the item bank lives in src/data/items-batch1.json and ItalianItem is an empty
/// Phase-2 seed target, so an FK here would reference nothing.
model AiEvaluation {
  id                   String      @id @default(cuid())
  userId               String
  skill                AiSkill
  stableItemId         String
  exam                 ItalianExam
  level                String
  section              String
  /// The learner's text, or the Whisper transcript for ORALE.
  response             String
  /// ORALE only: the stored clip and how confident the transcription was.
  audioUrl             String?
  transcriptConfidence Float?
  /// Low-confidence transcriptions are flagged rather than silently scored.
  needsReview          Boolean     @default(false)
  /// The labelled estimate. Shape is validated by Zod before it is written.
  evaluation           Json
  /// Carried on the row as well as inside `evaluation` so the honesty gate can assert it
  /// without parsing JSON, and so a row can never exist without saying what it is.
  labelKind            String //  always "ESTIMATE"
  model                String
  costCents            Int         @default(0)
  createdAt            DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([stableItemId])
}

/// A Stripe event this product has already acted on.
///
/// WHY THIS EXISTS. almi-billing-router forwards one Stripe event with THREE attempts on any
/// non-2xx (`BACKOFF_MS = [300, 900, 2700]` in src/lib/forward.ts), and its own comment states
/// the assumption it makes of every product: "products are idempotent on the same event id".
/// This product was not. A forwarded `customer.subscription.created` that failed to ack — a
/// timeout, a cold start, a 500 — arrived again and sent the learner a second and third
/// subscription confirmation email.
///
/// `id` IS the Stripe event id, so the primary key does the enforcing: the claim is the INSERT,
/// not a preceding read. See the note in src/app/api/webhooks/stripe/route.ts for why the
/// read-then-write shape used elsewhere in the network is not sufficient here.
model ProcessedWebhook {
  /// The Stripe event id (evt_...). Primary key: one row per event, enforced by the database.
  id          String   @id
  eventType   String
  processedAt DateTime @default(now())

  @@index([processedAt])
}
